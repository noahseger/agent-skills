{
  "name": "@noahseger/event-modeling",
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "imports": {
    "#em": "./src/index.ts"
  },
  "bin": {
    "em": "bin/em.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p viewer",
    "lint": "biome check .",
    "lint:proto": "buf lint examples/proto",
    "json": "node --experimental-strip-types --disable-warning=ExperimentalWarning bin/em.ts json",
    "render": "node --experimental-strip-types --disable-warning=ExperimentalWarning bin/em.ts render",
    "proto": "node --experimental-strip-types --disable-warning=ExperimentalWarning bin/em.ts proto",
    "view": "node --experimental-strip-types --disable-warning=ExperimentalWarning bin/em.ts view",
    "build": "vite build viewer",
    "viewer:dev": "vite viewer",
    "test": "npm run typecheck && npm run lint && npm run build && node --test --experimental-strip-types 'test/*.test.ts' && npm run lint:proto"
  },
  "dependencies": {
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@bufbuild/buf": "^1.72.0",
    "@types/node": "^26.4.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vue": "^3.5.42"
  }
}
